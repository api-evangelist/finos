        {
          "id": "eae662bc-6bb1-4045-b443-28f10357ccd2",
          "name": "Allows iteration of all file extensions supported for upload",
          "request": {
            "name": "Allows iteration of all file extensions supported for upload",
            "description": {
              "content": "Provides a RESTful API to iterate all file extensions configured by the tenant admin\nthat are allowed for the upload.  Pagination of this list is managed through a\ncombination of the optional request parameters and service-side managed maximums.\n\nPagination of the results is provided through the before or after input paramters\nand presented through the opaque cursor values provided as output from a previous\nresponse.  Only one of before or after or neither may be provided.\n\nDO NOT store cursors. Cursors can quickly become invalid if items are added or deleted.\nUse them only during a short-period of time that you are traversing the list.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "file_ext",
                "v1",
                "allowed_extensions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "This is the maximum number of objects that may be returned. A query may return\nfewer than the value of limit due to filtering or service-side maximums. Do not\ndepend on the number of results being fewer than the limit value to indicate your\nquery reached the end of the list of data, use the absence of next instead as\ndescribed below. For example, if you set limit to 10 and 9 results are returned,\nthere may be more data available, but one item was removed due to privacy filtering.\nSome maximums for limit may be enforced for performance reasons. In all cases, the\nAPI returns the correct pagination links.\n",
                    "type": "text/plain"
                  },
                  "key": "limit",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Returns results from an opaque \"before\" cursor value as presented via a response cursor\n",
                    "type": "text/plain"
                  },
                  "key": "before",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Returns results from an opaque \"after\" cursor value as presented via a response cursor\n",
                    "type": "text/plain"
                  },
                  "key": "after",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
