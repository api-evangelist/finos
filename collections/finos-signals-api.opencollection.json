                "value": ""
              },
              {
                "name": "keyManagerToken",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the signal to display."
              }
            ]
          },
          "docs": "Get details of the requested signal."
        },
