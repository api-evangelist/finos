        {
          "id": "43a7e96e-4e6d-47d3-938b-adf4400b76a5",
          "name": "Returns the list of active datafeeds of the user.",
          "request": {
            "name": "Returns the list of active datafeeds of the user.",
            "description": {
              "content": "_Available on Agent 2.57.0 and above._\n\nThe datafeed provides messages and events from all conversations that the user\nis in. The types of events surfaced in the datafeed can be found in the [Real Time Events](./docs/real-time-events.md) list.\nIn most cases, only one active datafeed per user is required at a time.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v5",
                "datafeeds"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "A unique identifier to ensure uniqueness of the datafeed. Used to restrict search."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Session authentication token.",
                "key": "sessionToken",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Key Manager authentication token.",
                "key": "keyManagerToken",
                "value": "<string>"
              },
