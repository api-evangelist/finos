        {
          "id": "8ee44b0b-c2f5-4677-a8ad-5fb832fba4b9",
          "name": "Read the specified real time message / event stream (\"datafeed\").",
          "request": {
            "name": "Read the specified real time message / event stream (\"datafeed\").",
            "description": {
              "content": "_Available on Agent 2.57.0 and above._\n\nThe datafeed provides messages and events from all conversations that the user\nis in. The types of events surfaced in the datafeed can be found in the Real Time Events list.\n(see definition on top of the file)\n\nRead the specified datafeed.\n\nThe ackId sent as parameter can be empty for the first call. In the response an ackId will be sent back and it can be used for\nthe next call: in this way you acknowledge that you have received the events that came with that ackId; datafeed will remove the events\nassociated with that ackId from your queue\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v5",
                "datafeeds",
                ":datafeedId",
                "read"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "datafeedId",
                  "description": "(Required) ID of the datafeed"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Session authentication token.",
                "key": "sessionToken",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Key Manager authentication token.",
                "key": "keyManagerToken",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ackId\": \"<string>\",\n  \"updatePresence\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
