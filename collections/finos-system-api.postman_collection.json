        {
          "id": "9c18f04b-bdc8-4a4d-9e65-e59cbd8bbf89",
          "name": "Checks health status of services and users",
          "request": {
            "name": "Checks health status of services and users",
            "description": {
              "content": "_Available on Agent 2.57.0 and above._\n\nReturns the connectivity status of the Agent services (**pod**, **key manager** and **datafeed**) as well as users\nconnectivity (**agentservice** and **ceservice**).\n\nThe global status will be set to `DOWN` if at least one of the sub-status is also `DOWN`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "health",
                "extended"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6eba6f35-b05e-4a1a-b27c-e7a59c1e6434",
              "name": "Agent is healthy, all components are `UP`.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v3",
                    "health",
                    "extended"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"services\": {\n    \"pod\": {\n      \"status\": \"UP\",\n      \"version\": \"24.1.1-411-36efd5b\"\n    },\n    \"key_manager\": {\n      \"status\": \"UP\",\n      \"version\": \"24.1.1-411-36efd5b\"\n    },\n    \"datafeed\": {\n      \"status\": \"UP\",\n      \"version\": \"2.11.6\"\n    }\n  },\n  \"status\": \"UP\",\n  \"users\": {\n    \"agentservice\": {\n      \"authType\": \"RSA\",\n      \"status\": \"UP\"\n    },\n    \"ceservice\": {\n      \"authType\": \"RSA\",\n      \"status\": \"UP\"\n    }\n  },\n  \"version\": \"24.3.2-778\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
