              "body": "{\n  \"services\": {\n    \"pod\": {\n      \"status\": \"UP\",\n      \"version\": \"24.1.1-411-36efd5b\"\n    },\n    \"key_manager\": {\n      \"status\": \"DOWN\",\n      \"version\": \"24.1.1-411-36efd5b\"\n    },\n    \"datafeed\": {\n      \"status\": \"UP\",\n      \"version\": \"2.11.6\"\n    }\n  },\n  \"status\": \"UP\",\n  \"users\": {\n    \"agentservice\": {\n      \"authType\": \"RSA\",\n      \"status\": \"UP\"\n    },\n    \"ceservice\": {\n      \"authType\": \"RSA\",\n      \"status\": \"UP\"\n    }\n  },\n  \"version\": \"24.3.2-778\"\n}",
